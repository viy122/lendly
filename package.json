{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test:map": "node --test tests/JavaScript/map-location.test.mjs",
        "test:e2e": "bash tests/e2e/run.sh",
        "test:e2e:component": "bash tests/e2e/run.sh --spec tests/e2e/specs/component.e2e.cjs",
        "test:e2e:module": "bash tests/e2e/run.sh --spec tests/e2e/specs/module.e2e.cjs",
        "test:e2e:integrated": "bash tests/e2e/run.sh --spec tests/e2e/specs/full-cycle.e2e.cjs",
        "test:e2e:report": "node tests/e2e/report/build-report.cjs"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "@wdio/cli": "^10.0.2",
        "@wdio/local-runner": "^10.0.2",
        "@wdio/mocha-framework": "^10.0.1",
        "@wdio/spec-reporter": "^10.0.1",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "chromedriver": "^156.0.2",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7",
        "wdio-chromedriver-service": "^8.1.1"
    },
    "dependencies": {
        "jsqr": "^1.4.0",
        "leaflet": "^1.9.4"
    }
}
